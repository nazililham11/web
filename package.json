        "vue": "^3.5.24"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/tsconfig": "^0.8.1",
        "typescript": "~5.9.3",
        "vite": "npm:rolldown-vite@7.2.5",
